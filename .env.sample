# --- Shared Postgres (docker-compose.yml: db, db-init) — one instance for
# --- both GoTrue and IAM, see scripts/db-init.sh for why one instance,
# --- two schemas rather than two separate database servers. ---
POSTGRES_PASSWORD=            # db superuser password, anything for dev
POSTGRES_DB=postgres          # shared database name — both auth and iam schemas live inside it
AUTH_DB_USER=supabase_auth_admin
AUTH_DB_PASSWORD=             # anything for dev
IAM_DB_USER=iam
IAM_DB_PASSWORD=              # anything for dev
GOOGLE_CLIENT_ID=             # optional — see README "Testing Google sign-in"
GOOGLE_CLIENT_SECRET=         # optional
GOTRUE_JWT_SECRET=            # 32+ chars, anything for dev — `openssl rand -hex 32`
GOTRUE_RATE_LIMIT_EMAIL_SENT=30  # optional — defaults to 30 in docker-compose.yml if unset
GOTRUE_PASSWORD_MIN_LENGTH=8     # optional — defaults to 8 in docker-compose.yml if unset

# --- Self-hosted GoTrue (raw container, no Kong -> no /auth/v1 prefix) ---
# Only used by `go run ./cmd/server` on the host — the iam-server service
# inside docker-compose.yml talks to gotrue over the internal Docker
# network instead (http://gotrue:9999), regardless of this value.
SUPABASE_URL=http://localhost:9999
# apiKey header is sent but ignored by raw self-hosted GoTrue. Any
# non-empty placeholder works unless a Kong gateway is added later.
SUPABASE_ANON_KEY=local-dev-placeholder

# --- IAM's own identity store — the `iam` schema of the shared Postgres
# --- instance above (see POSTGRES_DB), not a separate database. ---
# Only used by `go run ./cmd/server` on the host, same caveat as
# SUPABASE_URL above — iam-server inside compose uses db:5432 instead.
# No manual schema step needed either way: migrations run automatically at
# startup (internal/adapters/outbound/postgres/migrations).
DATABASE_URL=postgresql://iam:<IAM_DB_PASSWORD from above>@localhost:5432/postgres?sslmode=disable

# --- This server's own /callback route. Must also be added under Supabase's ---
# --- Authentication -> URL Configuration -> Redirect URLs.                 ---
IAM_CALLBACK_URL=http://localhost:8080/callback

# --- Ed25519 private key PEM for signing JWTs: generate with `go run ./cmd/genkey` ---
# Single line, newlines as literal \n, e.g.:
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMC4CAQ...\n-----END PRIVATE KEY-----
JWT_PRIVATE_KEY=

# --- Optional — all have defaults in internal/config/config.go ---
IAM_ENV=development                # "production" switches ziplog to JSON output
IAM_PORT=8080
JWT_ISSUER=https://auth.company.com
JWT_KEY_ID=iam-key-1
IAM_ALLOWED_APPS={"demo":{"redirect_origins":["http://localhost:3000"]}}

# Published in JWKS but never signed with — only needed mid-rotation, see
# jwtsign.NewSigner's doc comment for the full procedure. Leave as [].
JWT_JWKS_EXTRA_KEYS=[]

# Per-IP token bucket guarding /login, /signup, /signin.
IAM_RATE_LIMIT_RPS=1
IAM_RATE_LIMIT_BURST=5

# ============================================================================
# --- Production only (docker-compose.prod.yml) — see README "Going to
# --- production". Irrelevant for `docker compose up -d` / `go run
# --- ./cmd/server`.
# ============================================================================
AUTH_DOMAIN=                 # e.g. auth.example.com — publicly resolves to this host, proxied to gotrue by Caddy
IAM_DOMAIN=                  # e.g. app.example.com — publicly resolves to this host, proxied to iam-server by Caddy
SITE_URL=                    # your application's own URL, e.g. https://example.com
GOTRUE_URI_ALLOW_LIST=       # comma-separated allowed return_to origins, e.g. https://example.com/*

GOTRUE_SMTP_ADMIN_EMAIL=     # required in prod — GOTRUE_MAILER_AUTOCONFIRM is off there
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
